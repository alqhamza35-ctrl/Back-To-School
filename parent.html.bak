<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com;">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="X-Frame-Options" content="DENY">
    <title data-i18n="page_parent_title">لوحة متابعة الوالدين - العودة للمدرسة</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* ========================================
           Parent Dashboard - Base
           ======================================== */
        .parent-page {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            background: var(--bg-dark);
            padding: 30px 20px;
        }

        /* ========================================
           Header
           ======================================== */
        .pv-header {
            width: 100%;
            max-width: 1000px;
            text-align: center;
            margin-bottom: 32px;
            position: relative;
        }

        .pv-header .brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 8px;
        }

        .pv-header .brand-icon {
            width: 52px;
            height: 52px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: white;
            flex-shrink: 0;
        }

        .pv-header h1 {
            font-size: 26px;
            font-weight: 800;
        }

        .pv-header .subtitle {
            color: var(--text-secondary);
            font-size: 14px;
            margin-top: 4px;
        }

        .pv-nav {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            pointer-events: none;
        }

        .pv-nav > * {
            pointer-events: all;
        }

        .pv-btn {
            background: var(--bg-input);
            border: 2px solid var(--border-color);
            color: var(--text-primary);
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }

        .pv-btn:hover {
            border-color: var(--primary);
            color: var(--primary-light);
        }

        .pv-btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-color: transparent;
            color: white;
        }

        .pv-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(108, 92, 231, 0.4);
            color: white;
        }

        .pv-btn-success {
            background: linear-gradient(135deg, var(--success) 0%, #00a884 100%);
            border-color: transparent;
            color: white;
        }

        .pv-btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 184, 148, 0.4);
        }

        .pv-btn-danger {
            background: rgba(225, 112, 85, 0.15);
            border-color: transparent;
            color: var(--danger);
        }

        .pv-btn-danger:hover {
            background: var(--danger);
            color: white;
        }

        .pv-btn-sm {
            padding: 6px 12px;
            font-size: 12px;
            border-radius: 8px;
        }

        /* ========================================
           Code Entry
           ======================================== */
        .code-entry {
            width: 100%;
            max-width: 500px;
            background: var(--bg-card);
            border-radius: 20px;
            padding: 40px 32px;
            border: 1px solid var(--border-color);
            text-align: center;
        }

        .code-entry .icon-circle {
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: white;
            margin: 0 auto 20px;
        }

        .code-entry h2 {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .code-entry p {
            color: var(--text-secondary);
            font-size: 14px;
            margin-bottom: 24px;
        }

        .code-input-row {
            display: flex;
            gap: 10px;
            max-width: 360px;
            margin: 0 auto;
        }

        .code-input-row input {
            flex: 1;
            padding: 14px 18px;
            background: var(--bg-input);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            color: var(--text-primary);
            font-family: inherit;
            font-size: 18px;
            font-weight: 700;
            text-align: center;
            letter-spacing: 3px;
            transition: var(--transition);
        }

        .code-input-row input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(108, 92, 231, 0.15);
        }

        .code-input-row input::placeholder {
            color: var(--text-muted);
            font-weight: 400;
            font-size: 15px;
            letter-spacing: 0;
        }

        .error-msg {
            color: var(--danger);
            font-size: 13px;
            margin-top: 12px;
            min-height: 18px;
        }

        .loading-spinner {
            display: none;
            margin: 16px auto 0;
        }

        .loading-spinner.show {
            display: block;
        }

        .spinner-circle {
            width: 36px;
            height: 36px;
            border: 3px solid var(--border-color);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* ========================================
           Dashboard (hidden until connected)
           ======================================== */
        .pv-dashboard {
            width: 100%;
            max-width: 1000px;
            display: none;
        }

        /* Student Header */
        .student-header {
            display: flex;
            align-items: center;
            gap: 16px;
            background: var(--bg-card);
            border-radius: 16px;
            padding: 20px 24px;
            border: 1px solid var(--border-color);
            margin-bottom: 20px;
        }

        .student-avatar {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: 800;
            color: white;
            flex-shrink: 0;
        }

        .student-info {
            flex: 1;
        }

        .student-info h3 {
            font-size: 17px;
            font-weight: 700;
        }

        .student-info p {
            color: var(--text-secondary);
            font-size: 13px;
        }

        .tracking-badge {
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 600;
            color: var(--primary-light);
            font-family: monospace;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: var(--transition);
        }

        .tracking-badge:hover {
            border-color: var(--primary);
            background: rgba(108, 92, 231, 0.1);
        }

        .tracking-badge .copy-hint {
            font-size: 11px;
            color: var(--text-muted);
            font-family: inherit;
            letter-spacing: 0;
        }

        /* Stats Grid */
        .pv-stats {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 14px;
            margin-bottom: 24px;
        }

        .pv-stat-card {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 18px 12px;
            border: 1px solid var(--border-color);
            text-align: center;
            transition: var(--transition);
        }

        .pv-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px var(--shadow-color);
        }

        .pv-stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            margin: 0 auto 10px;
        }

        .pv-stat-icon.purple { background: rgba(108, 92, 231, 0.15); color: var(--primary-light); }
        .pv-stat-icon.pink { background: rgba(253, 121, 168, 0.15); color: #fd79a8; }
        .pv-stat-icon.teal { background: rgba(0, 206, 201, 0.15); color: var(--secondary); }
        .pv-stat-icon.gold { background: rgba(253, 203, 110, 0.15); color: #fdcb6e; }
        .pv-stat-icon.green { background: rgba(0, 184, 148, 0.15); color: var(--success); }
        .pv-stat-icon.blue { background: rgba(116, 185, 255, 0.15); color: var(--info); }

        .pv-stat-num {
            display: block;
            font-size: 24px;
            font-weight: 800;
            line-height: 1.1;
        }

        .pv-stat-label {
            display: block;
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        /* ========================================
           Sections Grid
           ======================================== */
        .pv-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .pv-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 22px;
            border: 1px solid var(--border-color);
        }

        .pv-card h3 {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pv-card h3 i {
            color: var(--primary-light);
            font-size: 14px;
        }

        .pv-card.full-width {
            grid-column: 1 / -1;
        }

        /* Progress Bar */
        .pv-progress {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .pv-progress-bar {
            flex: 1;
            height: 12px;
            background: var(--bg-input);
            border-radius: 6px;
            overflow: hidden;
        }

        .pv-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--primary-light));
            border-radius: 6px;
            transition: width 0.6s ease;
        }

        .pv-progress-pct {
            font-size: 18px;
            font-weight: 800;
            min-width: 50px;
            text-align: left;
            color: var(--primary-light);
        }

        /* Level Card */
        .pv-level-wrap {
            text-align: center;
            padding: 8px 0;
        }

        .pv-level-num {
            font-size: 40px;
            font-weight: 800;
            color: var(--primary-light);
            line-height: 1;
        }

        .pv-level-title {
            font-size: 14px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        .pv-xp-bar {
            height: 8px;
            background: var(--bg-input);
            border-radius: 4px;
            overflow: hidden;
            margin: 12px 0 6px;
        }

        .pv-xp-fill {
            height: 100%;
            background: linear-gradient(90deg, #fdcb6e, #f39c12);
            border-radius: 4px;
            transition: width 0.5s;
        }

        .pv-xp-text {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Exam & Schedule Items */
        .pv-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid var(--border-color);
        }

        .pv-item:last-child {
            border-bottom: none;
        }

        .pv-item-title {
            font-weight: 600;
            font-size: 14px;
        }

        .pv-item-sub {
            font-size: 12px;
            color: var(--text-secondary);
        }

        .pv-item-date {
            font-size: 12px;
            color: var(--primary-light);
            font-weight: 600;
            white-space: nowrap;
        }

        .pv-item-time {
            font-size: 13px;
            color: var(--primary-light);
            font-weight: 600;
            min-width: 70px;
        }

        .pv-empty {
            color: var(--text-muted);
            font-size: 13px;
            text-align: center;
            padding: 24px 0;
        }

        /* Weekly Chart */
        .pv-chart {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            height: 130px;
            padding-top: 8px;
        }

        .pv-chart-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            height: 100%;
            justify-content: flex-end;
        }

        .pv-chart-bar {
            width: 100%;
            background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: 4px 4px 0 0;
            min-height: 2px;
            transition: height 0.5s ease;
        }

        .pv-chart-label {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 600;
        }

        /* ========================================
           Rewards Section
           ======================================== */
        .pv-rewards {
            margin-bottom: 24px;
        }

        .pv-rewards-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .pv-rewards-header h2 {
            font-size: 18px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pv-rewards-header h2 i {
            color: #fdcb6e;
        }

        /* Add Reward Form */
        .add-reward-form {
            display: none;
            background: var(--bg-card);
            border-radius: 16px;
            padding: 22px;
            border: 1px solid var(--border-color);
            margin-bottom: 16px;
            animation: fadeSlideIn 0.3s ease;
        }

        .add-reward-form.show {
            display: block;
        }

        @keyframes fadeSlideIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .add-reward-form h3 {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--primary-light);
        }

        .reward-form-row {
            display: grid;
            grid-template-columns: 2fr 1fr auto;
            gap: 12px;
            align-items: end;
        }

        .reward-form-row label {
            display: block;
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 6px;
            font-weight: 500;
        }

        .reward-form-row input {
            width: 100%;
            padding: 12px 14px;
            background: var(--bg-input);
            border: 2px solid var(--border-color);
            border-radius: 10px;
            color: var(--text-primary);
            font-family: inherit;
            font-size: 14px;
            transition: var(--transition);
        }

        .reward-form-row input:focus {
            outline: none;
            border-color: var(--primary);
        }

        /* Rewards List */
        .rewards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 14px;
        }

        .reward-card {
            background: var(--bg-card);
            border-radius: 14px;
            padding: 18px;
            border: 1px solid var(--border-color);
            transition: var(--transition);
        }

        .reward-card:hover {
            border-color: var(--primary);
        }

        .reward-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .reward-name {
            font-size: 15px;
            font-weight: 700;
        }

        .reward-status {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .reward-status.available {
            background: rgba(0, 184, 148, 0.15);
            color: var(--success);
        }

        .reward-status.pending {
            background: rgba(253, 203, 110, 0.2);
            color: #e6a817;
        }

        .reward-status.redeemed {
            background: rgba(108, 92, 231, 0.15);
            color: var(--primary-light);
        }

        .reward-points {
            font-size: 22px;
            font-weight: 800;
            color: #fdcb6e;
            margin: 6px 0;
        }

        .reward-points span {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
        }

        .reward-actions {
            display: flex;
            gap: 8px;
            margin-top: 10px;
        }

        .reward-actions .pv-btn {
            flex: 1;
            justify-content: center;
        }

        /* ========================================
           Toast
           ======================================== */
        .pv-toast {
            position: fixed;
            top: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(-100px);
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 14px 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 9999;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            font-size: 14px;
            font-weight: 600;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            max-width: 400px;
        }

        .pv-toast.show {
            transform: translateX(-50%) translateY(0);
        }

        .pv-toast.success {
            border-color: var(--success);
        }

        .pv-toast.error {
            border-color: var(--danger);
        }

        .pv-toast .toast-icon {
            font-size: 18px;
        }

        .pv-toast.success .toast-icon { color: var(--success); }
        .pv-toast.error .toast-icon { color: var(--danger); }

        /* ========================================
           Data Footer
           ======================================== */
        .pv-data-footer {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            margin-top: 16px;
            padding: 14px;
            background: var(--bg-card);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            font-size: 13px;
            color: var(--text-muted);
        }

        .pv-data-footer i {
            color: var(--primary-light);
        }

        /* ========================================
           Responsive
           ======================================== */
        @media (max-width: 900px) {
            .pv-stats {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 700px) {
            .parent-page {
                padding: 20px 14px;
            }

            .pv-nav {
                position: static;
                justify-content: center;
                gap: 10px;
                margin-bottom: 16px;
            }

            .pv-header h1 {
                font-size: 22px;
            }

            .pv-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .pv-grid {
                grid-template-columns: 1fr;
            }

            .student-header {
                flex-direction: column;
                text-align: center;
            }

            .tracking-badge {
                align-self: center;
            }

            .reward-form-row {
                grid-template-columns: 1fr;
            }

            .rewards-grid {
                grid-template-columns: 1fr;
            }

            .pv-chart {
                height: 100px;
            }
        }

        @media (max-width: 480px) {
            .pv-stats {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .pv-stat-card {
                padding: 14px 8px;
            }

            .pv-stat-num {
                font-size: 20px;
            }
        }

        /* Light Theme */
        [data-theme="light"] .parent-page {
            background: var(--bg-dark);
        }

        [data-theme="light"] .student-header,
        [data-theme="light"] .pv-card,
        [data-theme="light"] .pv-stat-card,
        [data-theme="light"] .pv-rewards-header,
        [data-theme="light"] .add-reward-form,
        [data-theme="light"] .reward-card,
        [data-theme="light"] .pv-data-footer {
            background: var(--bg-card);
            border-color: var(--border-color);
        }
    </style>
</head>
<body class="parent-page">
    <!-- ========================================
         Header
         ======================================== -->
    <div class="pv-header">
        <div class="pv-nav">
            <button class="pv-btn" id="langToggle"><i class="fas fa-globe"></i> <span id="langLabel">EN</span></button>
            <a href="index.html" class="pv-btn"><i class="fas fa-arrow-right"></i> <span data-i18n="parent_back">العودة للرئيسية</span></a>
        </div>
        <div class="brand">
            <div class="brand-icon"><i class="fas fa-graduation-cap"></i></div>
            <h1 data-i18n="app_name">العودة للمدرسة</h1>
        </div>
        <p class="subtitle" data-i18n="parent_view_subtitle">لوحة متابعة الوالدين - تتبع تقدم طفلك الدراسي</p>
    </div>

    <!-- ========================================
         Code Entry
         ======================================== -->
    <div class="code-entry" id="codeEntry">
        <div class="icon-circle"><i class="fas fa-key"></i></div>
        <h2 data-i18n="parent_enter_code">أدخل رمز المتابعة</h2>
        <p data-i18n="parent_enter_code_desc">أدخل الرمز الذي حصلت عليه من طفلك لمتابعة تقدمه</p>
        <div class="code-input-row">
            <input type="text" id="trackingCodeInput" placeholder="BTS-XXXXXX" maxlength="10" autocomplete="off" spellcheck="false">
            <button class="pv-btn pv-btn-primary" id="connectBtn"><i class="fas fa-link"></i> <span data-i18n="parent_connect">ربط</span></button>
        </div>
        <div class="error-msg" id="codeError"></div>
        <div class="loading-spinner" id="loadingSpinner"><div class="spinner-circle"></div></div>
    </div>

    <!-- ========================================
         Dashboard
         ======================================== -->
    <div class="pv-dashboard" id="parentDashboard">
        <!-- Student Header -->
        <div class="student-header">
            <div class="student-avatar" id="studentAvatar">م</div>
            <div class="student-info">
                <h3 id="studentName">-</h3>
                <p id="studentEmail">-</p>
            </div>
            <div class="tracking-badge" id="trackingCode" title="Click to copy">
                <span id="trackingCodeText">---</span>
                <i class="fas fa-copy" style="font-size:12px;opacity:0.6"></i>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="pv-stats">
            <div class="pv-stat-card">
                <div class="pv-stat-icon green"><i class="fas fa-check-double"></i></div>
                <span class="pv-stat-num" id="statCompletedHW">0</span>
                <span class="pv-stat-label" data-i18n="pv_hw_completed">واجب مكتمل</span>
            </div>
            <div class="pv-stat-card">
                <div class="pv-stat-icon pink"><i class="fas fa-hourglass-half"></i></div>
                <span class="pv-stat-num" id="statPendingHW">0</span>
                <span class="pv-stat-label" data-i18n="pv_hw_pending">واجب متبقي</span>
            </div>
            <div class="pv-stat-card">
                <div class="pv-stat-icon teal"><i class="fas fa-clock"></i></div>
                <span class="pv-stat-num" id="statStudyHours">0</span>
                <span class="pv-stat-label" data-i18n="pv_study_hours">ساعة مذاكرة</span>
            </div>
            <div class="pv-stat-card">
                <div class="pv-stat-icon gold"><i class="fas fa-star"></i></div>
                <span class="pv-stat-num" id="statPoints">0</span>
                <span class="pv-stat-label" data-i18n="pv_points">نقطة</span>
            </div>
            <div class="pv-stat-card">
                <div class="pv-stat-icon purple"><i class="fas fa-fire"></i></div>
                <span class="pv-stat-num" id="statStreak">0</span>
                <span class="pv-stat-label" data-i18n="pv_streak">سلسلة أيام</span>
            </div>
            <div class="pv-stat-card">
                <div class="pv-stat-icon blue"><i class="fas fa-trophy"></i></div>
                <span class="pv-stat-num" id="statLevel">1</span>
                <span class="pv-stat-label" data-i18n="pv_level_short">المستوى</span>
            </div>
        </div>

        <!-- Rewards Section -->
        <div class="pv-rewards">
            <div class="pv-rewards-header">
                <h2><i class="fas fa-gift"></i> <span data-i18n="pv_rewards">نظام المكافآت</span></h2>
                <button class="pv-btn pv-btn-primary pv-btn-sm" id="toggleAddReward"><i class="fas fa-plus"></i> <span data-i18n="pv_add_reward">إضافة مكافأة</span></button>
            </div>

            <!-- Add Reward Form -->
            <div class="add-reward-form" id="addRewardForm">
                <h3><i class="fas fa-plus-circle"></i> <span data-i18n="pv_new_reward">مكافأة جديدة</span></h3>
                <div class="reward-form-row">
                    <div>
                        <label data-i18n="pv_reward_name">اسم المكافأة</label>
                        <input type="text" id="rewardNameInput" placeholder="مثال: ساعة لعب إضافية" data-i18n-placeholder="pv_reward_name_ph">
                    </div>
                    <div>
                        <label data-i18n="pv_reward_cost">عدد النقاط المطلوبة</label>
                        <input type="number" id="rewardPointsInput" min="1" max="10000" placeholder="50">
                    </div>
                    <button class="pv-btn pv-btn-success pv-btn-sm" id="submitReward" style="height:44px"><i class="fas fa-check"></i> <span data-i18n="pv_activate">تفعيل</span></button>
                </div>
            </div>

            <!-- Rewards List -->
            <div class="rewards-grid" id="rewardsList">
                <div class="pv-empty" data-i18n="pv_no_rewards">لم تُضف أي مكافآت بعد</div>
            </div>
        </div>

        <!-- Sections Grid -->
        <div class="pv-grid">
            <!-- Homework Progress -->
            <div class="pv-card">
                <h3><i class="fas fa-tasks"></i> <span data-i18n="pv_hw_progress">نسب إنجاز الواجبات</span></h3>
                <div class="pv-progress">
                    <div class="pv-progress-bar">
                        <div class="pv-progress-fill" id="hwProgressFill" style="width: 0%"></div>
                    </div>
                    <span class="pv-progress-pct" id="hwProgressPct">0%</span>
                </div>
            </div>

            <!-- Level & XP -->
            <div class="pv-card">
                <h3><i class="fas fa-star"></i> <span data-i18n="pv_level_section">المستوى والخبرة</span></h3>
                <div class="pv-level-wrap">
                    <div class="pv-level-num" id="levelNum">1</div>
                    <div class="pv-level-title" id="levelTitle">مبتدئ</div>
                    <div class="pv-xp-bar"><div class="pv-xp-fill" id="xpFill" style="width: 0%"></div></div>
                    <div class="pv-xp-text"><span id="currentXP">0</span> / <span id="nextLevelXP">100</span> <span data-i18n="pv_xp">نقطة خبرة</span></div>
                </div>
            </div>

            <!-- Upcoming Exams -->
            <div class="pv-card">
                <h3><i class="fas fa-file-alt"></i> <span data-i18n="pv_upcoming_exams">الامتحانات القادمة</span></h3>
                <div id="examsList"><div class="pv-empty" data-i18n="pv_no_exams">لا توجد امتحانات قادمة</div></div>
            </div>

            <!-- Daily Schedule -->
            <div class="pv-card">
                <h3><i class="fas fa-calendar-day"></i> <span data-i18n="pv_daily_schedule">جدول اليوم</span></h3>
                <div id="scheduleList"><div class="pv-empty" data-i18n="pv_no_schedule">لم يتم إنشاء جدول بعد</div></div>
            </div>

            <!-- Weekly Chart -->
            <div class="pv-card full-width">
                <h3><i class="fas fa-chart-bar"></i> <span data-i18n="pv_study_activity">نشاط المذاكرة (آخر 7 أيام)</span></h3>
                <div class="pv-chart" id="weeklyChart"></div>
            </div>
        </div>

        <!-- Data Footer -->
        <div class="pv-data-footer">
            <i class="fas fa-sync-alt"></i>
            <span data-i18n="pv_last_updated">آخر تحديث:</span>
            <span id="lastUpdated">-</span>
            <button class="pv-btn pv-btn-sm" id="refreshBtn"><i class="fas fa-redo"></i> <span data-i18n="pv_refresh">تحديث</span></button>
            <button class="pv-btn pv-btn-danger pv-btn-sm" id="disconnectBtn"><i class="fas fa-unlink"></i> <span data-i18n="pv_disconnect">فصل الاتصال</span></button>
        </div>
    </div>

    <!-- Toast -->
    <div class="pv-toast" id="toast">
        <i class="fas toast-icon"></i>
        <span id="toastMsg"></span>
    </div>

    <!-- Firebase Scripts -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
    <script src="firebase-config.js"></script>

    <script>
    (function() {
        'use strict';

        // ========================================
        // Translations
        // ========================================
        var t = {
            ar: {
                app_name: 'العودة للمدرسة',
                parent_back: 'العودة للرئيسية',
                parent_view_subtitle: 'لوحة متابعة الوالدين - تتبع تقدم طفلك الدراسي',
                parent_enter_code: 'أدخل رمز المتابعة',
                parent_enter_code_desc: 'أدخل الرمز الذي حصلت عليه من طفلك لمتابعة تقدمه',
                parent_connect: 'ربط',
                pv_hw_completed: 'واجب مكتمل',
                pv_hw_pending: 'واجب متبقي',
                pv_study_hours: 'ساعة مذاكرة',
                pv_points: 'نقطة',
                pv_streak: 'سلسلة أيام',
                pv_level_short: 'المستوى',
                pv_rewards: 'نظام المكافآت',
                pv_add_reward: 'إضافة مكافأة',
                pv_new_reward: 'مكافأة جديدة',
                pv_reward_name: 'اسم المكافأة',
                pv_reward_name_ph: 'مثال: ساعة لعب إضافية',
                pv_reward_cost: 'عدد النقاط المطلوبة',
                pv_activate: 'تفعيل',
                pv_no_rewards: 'لم تُضف أي مكافآت بعد',
                pv_hw_progress: 'نسب إنجاز الواجبات',
                pv_level_section: 'المستوى والخبرة',
                pv_xp: 'نقطة خبرة',
                pv_upcoming_exams: 'الامتحانات القادمة',
                pv_no_exams: 'لا توجد امتحانات قادمة',
                pv_daily_schedule: 'جدول اليوم',
                pv_no_schedule: 'لم يتم إنشاء جدول بعد',
                pv_study_activity: 'نشاط المذاكرة (آخر 7 أيام)',
                pv_last_updated: 'آخر تحديث:',
                pv_refresh: 'تحديث',
                pv_disconnect: 'فصل الاتصال',
                pv_error_code: 'رمز غير صحيح. تأكد من الرمز وأعد المحاولة.',
                pv_error_network: 'خطأ في الاتصال بالخادم. حاول مرة أخرى.',
                pv_success_connect: 'تم الاتصال بنجاح!',
                pv_success_reward_added: 'تمت إضافة المكافأة بنجاح',
                pv_success_reward_redeem: 'تم طلب استبدال المكافأة. في انتظار موافقة الوالد.',
                pv_success_approved: 'تمت الموافقة على المكافأة!',
                pv_success_rejected: 'تم رفض طلب الاستبدال',
                pv_success_points_deducted: 'تم خصم النقاط',
                pv_level_titles: ['مبتدئ', 'متوسط', 'متمرس', 'خبير', 'سيد', 'أسطوري'],
                pv_minutes: 'دقيقة',
                pv_available: 'متاحة',
                pv_pending: 'بانتظار الموافقة',
                pv_redeemed: 'تم الاستبدال',
                pv_approve: 'موافقة',
                pv_reject: 'رفض',
                pv_delete: 'حذف',
                pv_points_label: 'نقطة',
                pv_copy_code: 'تم نسخ الرمز!'
            },
            en: {
                app_name: 'Back to School',
                parent_back: 'Back to Home',
                parent_view_subtitle: 'Parent Dashboard - Track your child\'s academic progress',
                parent_enter_code: 'Enter Tracking Code',
                parent_enter_code_desc: 'Enter the code you received from your child to track their progress',
                parent_connect: 'Track',
                pv_hw_completed: 'HW Done',
                pv_hw_pending: 'HW Pending',
                pv_study_hours: 'Study Hours',
                pv_points: 'Points',
                pv_streak: 'Day Streak',
                pv_level_short: 'Level',
                pv_rewards: 'Rewards System',
                pv_add_reward: 'Add Reward',
                pv_new_reward: 'New Reward',
                pv_reward_name: 'Reward Name',
                pv_reward_name_ph: 'e.g. Extra play time',
                pv_reward_cost: 'Points Required',
                pv_activate: 'Activate',
                pv_no_rewards: 'No rewards added yet',
                pv_hw_progress: 'Homework Completion',
                pv_level_section: 'Level & Experience',
                pv_xp: 'XP',
                pv_upcoming_exams: 'Upcoming Exams',
                pv_no_exams: 'No upcoming exams',
                pv_daily_schedule: 'Today\'s Schedule',
                pv_no_schedule: 'No schedule created yet',
                pv_study_activity: 'Study Activity (Last 7 Days)',
                pv_last_updated: 'Last updated:',
                pv_refresh: 'Refresh',
                pv_disconnect: 'Disconnect',
                pv_error_code: 'Invalid code. Please check and try again.',
                pv_error_network: 'Network error. Please try again.',
                pv_success_connect: 'Connected successfully!',
                pv_success_reward_added: 'Reward added successfully',
                pv_success_reward_redeem: 'Redemption request sent. Awaiting parent approval.',
                pv_success_approved: 'Reward approved!',
                pv_success_rejected: 'Redemption rejected',
                pv_success_points_deducted: 'Points deducted',
                pv_level_titles: ['Beginner', 'Intermediate', 'Advanced', 'Expert', 'Master', 'Legendary'],
                pv_minutes: 'minutes',
                pv_available: 'Available',
                pv_pending: 'Pending Approval',
                pv_redeemed: 'Redeemed',
                pv_approve: 'Approve',
                pv_reject: 'Reject',
                pv_delete: 'Delete',
                pv_points_label: 'pts',
                pv_copy_code: 'Code copied!'
            }
        };

        var currentLang = localStorage.getItem('bts_lang') || 'ar';
        var connectedUserId = null;
        var rewardsUnsub = null;
        var refreshTimer = null;

        // ========================================
        // Utilities
        // ========================================
        function escapeHtml(str) {
            if (typeof str !== 'string') return '';
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(str));
            return div.innerHTML;
        }

        function formatTime12(timeStr) {
            if (!timeStr) return '';
            var parts = timeStr.split(':');
            var h = parseInt(parts[0]);
            var m = parts[1];
            var period = h >= 12 ? (currentLang === 'ar' ? 'م' : 'PM') : (currentLang === 'ar' ? 'ص' : 'AM');
            var h12 = h % 12 || 12;
            return h12 + ':' + m + ' ' + period;
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            var d = new Date(dateStr);
            return d.toLocaleDateString(currentLang === 'ar' ? 'ar-EG' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        function getTranslation(key) {
            return t[currentLang][key] || t['ar'][key] || key;
        }

        // ========================================
        // Language System
        // ========================================
        function switchLang(lang) {
            currentLang = lang;
            localStorage.setItem('bts_lang', lang);
            document.documentElement.lang = lang;
            document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
            var lbl = document.getElementById('langLabel');
            if (lbl) lbl.textContent = lang === 'ar' ? 'EN' : 'عربي';
            document.querySelectorAll('[data-i18n]').forEach(function(el) {
                var key = el.getAttribute('data-i18n');
                if (t[lang][key]) el.textContent = t[lang][key];
            });
            document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
                var key = el.getAttribute('data-i18n-placeholder');
                if (t[lang][key]) el.placeholder = t[lang][key];
            });
            // Re-render data-dependent sections
            if (connectedUserId) loadAllStudentData(connectedUserId);
        }

        function initLang() {
            switchLang(currentLang);
            document.getElementById('langToggle').addEventListener('click', function() {
                switchLang(currentLang === 'ar' ? 'en' : 'ar');
            });
        }

        // ========================================
        // Toast Notifications
        // ========================================
        function showToast(msg, type) {
            var toast = document.getElementById('toast');
            var icon = toast.querySelector('.toast-icon');
            toast.className = 'pv-toast ' + (type || 'success');
            icon.className = 'fas toast-icon ' + (type === 'error' ? 'fa-exclamation-circle' : 'fa-check-circle');
            document.getElementById('toastMsg').textContent = msg;
            toast.classList.add('show');
            setTimeout(function() { toast.classList.remove('show'); }, 3000);
        }

        // ========================================
        // Student Connection (Firestore lookup)
        // ========================================
        function connectStudent() {
            var input = document.getElementById('trackingCodeInput');
            var errorEl = document.getElementById('codeError');
            var spinner = document.getElementById('loadingSpinner');
            var code = input.value.trim().toUpperCase();

            errorEl.textContent = '';
            if (!code) {
                errorEl.textContent = getTranslation('pv_error_code');
                return;
            }

            spinner.classList.add('show');
            document.getElementById('connectBtn').disabled = true;

            // Look up student by parentCode in Firestore
            FirebaseFirestore.findUserByParentCode(code)
                .then(function(snapshot) {
                    if (snapshot.empty) {
                        errorEl.textContent = getTranslation('pv_error_code');
                        spinner.classList.remove('show');
                        document.getElementById('connectBtn').disabled = false;
                        return;
                    }
                    var doc = snapshot.docs[0];
                    connectedUserId = doc.id;
                    var userData = doc.data();

                    // Show dashboard
                    document.getElementById('codeEntry').style.display = 'none';
                    document.getElementById('parentDashboard').style.display = 'block';

                    // Display student info
                    var initial = userData.displayName ? userData.displayName.charAt(0) : 'م';
                    document.getElementById('studentAvatar').textContent = initial;
                    document.getElementById('studentName').textContent = userData.displayName || '-';
                    document.getElementById('studentEmail').textContent = userData.email || '-';
                    document.getElementById('trackingCodeText').textContent = code;

                    spinner.classList.remove('show');
                    showToast(getTranslation('pv_success_connect'), 'success');

                    // Load all data + start listeners
                    loadAllStudentData(connectedUserId);
                    startRewardsListener(connectedUserId);
                    startAutoRefresh(connectedUserId);
                })
                .catch(function(err) {
                    console.error('Firestore lookup error:', err);
                    errorEl.textContent = getTranslation('pv_error_network');
                    spinner.classList.remove('show');
                    document.getElementById('connectBtn').disabled = false;
                });
        }

        // ========================================
        // Load All Student Data from Firestore
        // ========================================
        function loadAllStudentData(userId) {
            var promises = [
                FirebaseFirestore.getHomework(userId),
                FirebaseFirestore.getExams(userId),
                FirebaseFirestore.getClasses(userId),
                FirebaseFirestore.getSchedule(userId),
                FirebaseFirestore.getGamification(userId),
                FirebaseFirestore.getPomodoro(userId)
            ];

            Promise.all(promises)
                .then(function(results) {
                    var hw = results[0].exists() ? (results[0].data().items || []) : [];
                    var exams = results[1].exists() ? (results[1].data().items || []) : [];
                    var classes = results[2].exists() ? (results[2].data().items || []) : [];
                    var schedule = results[3].exists() ? (results[3].data().items || []) : [];
                    var gam = results[4].exists() ? results[4].data() : { points: 0, xp: 0, level: 1, streak: 0 };
                    var pomo = results[5].exists() ? results[5].data() : { todayStats: { totalMinutes: 0 } };

                    renderStats(hw, gam, pomo);
                    renderHWProgress(hw);
                    renderLevel(gam);
                    renderExams(exams);
                    renderSchedule(schedule);
                    renderWeeklyChart(classes);
                    updateTimestamp();
                })
                .catch(function(err) {
                    console.error('Error loading student data:', err);
                });
        }

        // ========================================
        // Render Functions
        // ========================================
        function renderStats(hw, gam, pomo) {
            var completed = hw.filter(function(h) { return h.completed; }).length;
            var pending = hw.filter(function(h) { return !h.completed; }).length;
            var studyHours = ((pomo.todayStats ? pomo.todayStats.totalMinutes : 0) / 60).toFixed(1);

            document.getElementById('statCompletedHW').textContent = completed;
            document.getElementById('statPendingHW').textContent = pending;
            document.getElementById('statStudyHours').textContent = studyHours;
            document.getElementById('statPoints').textContent = gam.points || 0;
            document.getElementById('statStreak').textContent = gam.streak || 0;
            document.getElementById('statLevel').textContent = gam.level || 1;
        }

        function renderHWProgress(hw) {
            var completed = hw.filter(function(h) { return h.completed; }).length;
            var total = hw.length;
            var pct = total === 0 ? 0 : Math.round((completed / total) * 100);
            document.getElementById('hwProgressFill').style.width = pct + '%';
            document.getElementById('hwProgressPct').textContent = pct + '%';
        }

        function renderLevel(gam) {
            var levelTitles = t[currentLang].pv_level_titles;
            var titleIndex = Math.min(Math.floor((gam.level || 1) / 3), levelTitles.length - 1);
            document.getElementById('levelNum').textContent = gam.level || 1;
            document.getElementById('levelTitle').textContent = levelTitles[titleIndex];
            document.getElementById('currentXP').textContent = gam.xp || 0;
            document.getElementById('nextLevelXP').textContent = (gam.level || 1) * 100;
            var xpPercent = Math.min(100, ((gam.xp || 0) / ((gam.level || 1) * 100)) * 100);
            document.getElementById('xpFill').style.width = xpPercent + '%';
        }

        function renderExams(exams) {
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            var upcoming = exams
                .filter(function(e) { return new Date(e.date) >= today; })
                .sort(function(a, b) { return new Date(a.date) - new Date(b.date); })
                .slice(0, 5);

            var el = document.getElementById('examsList');
            if (upcoming.length === 0) {
                el.innerHTML = '<div class="pv-empty">' + getTranslation('pv_no_exams') + '</div>';
                return;
            }
            el.innerHTML = upcoming.map(function(e) {
                return '<div class="pv-item">' +
                    '<div><div class="pv-item-title">' + escapeHtml(e.name) + '</div>' +
                    '<div class="pv-item-sub">' + escapeHtml(e.subject) + '</div></div>' +
                    '<div class="pv-item-date">' + formatDate(e.date) + '</div></div>';
            }).join('');
        }

        function renderSchedule(sched) {
            var el = document.getElementById('scheduleList');
            if (sched.length === 0) {
                el.innerHTML = '<div class="pv-empty">' + getTranslation('pv_no_schedule') + '</div>';
                return;
            }
            el.innerHTML = sched.slice(0, 8).map(function(item) {
                return '<div class="pv-item">' +
                    '<span class="pv-item-time">' + formatTime12(item.time) + '</span>' +
                    '<span class="pv-item-title">' + escapeHtml(item.activity) + '</span></div>';
            }).join('');
        }

        function renderWeeklyChart(classes) {
            var dayLabels = currentLang === 'ar'
                ? ['سب', 'أح', 'إث', 'ثل', 'أر', 'خم', 'جم']
                : ['Sat', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
            var today = new Date();
            var html = '';

            for (var i = 6; i >= 0; i--) {
                var d = new Date(today);
                d.setDate(d.getDate() - i);
                var dateStr = d.toISOString().split('T')[0];
                var dayCls = classes.filter(function(c) { return c.date === dateStr; });
                var totalMin = dayCls.reduce(function(s, c) { return s + (c.duration || 0); }, 0);
                var height = Math.min(100, (totalMin / 300) * 100);
                var dayIdx = d.getDay();
                html += '<div class="pv-chart-col">' +
                    '<div class="pv-chart-bar" style="height:' + height + '%"></div>' +
                    '<span class="pv-chart-label">' + dayLabels[dayIdx] + '</span></div>';
            }
            document.getElementById('weeklyChart').innerHTML = html;
        }

        function updateTimestamp() {
            var now = new Date();
            var timeStr = now.toLocaleTimeString(currentLang === 'ar' ? 'ar-EG' : 'en-US', { hour: '2-digit', minute: '2-digit' });
            document.getElementById('lastUpdated').textContent = timeStr;
        }

        // ========================================
        // Rewards System (Firestore)
        // ========================================
        function startRewardsListener(userId) {
            // Unsubscribe previous listener
            if (rewardsUnsub) rewardsUnsub();

            // Real-time listener on rewards subcollection
            rewardsUnsub = db.collection('users').doc(userId).collection('rewards')
                .orderBy('createdAt', 'desc')
                .onSnapshot(function(snapshot) {
                    var rewards = [];
                    snapshot.forEach(function(doc) {
                        rewards.push({ id: doc.id, ...doc.data() });
                    });
                    renderRewards(rewards);
                }, function(err) {
                    console.error('Rewards listener error:', err);
                });
        }

        function renderRewards(rewards) {
            var el = document.getElementById('rewardsList');
            if (rewards.length === 0) {
                el.innerHTML = '<div class="pv-empty">' + getTranslation('pv_no_rewards') + '</div>';
                return;
            }

            el.innerHTML = rewards.map(function(reward) {
                var statusClass = reward.status || 'available';
                var statusText = getTranslation('pv_' + statusClass);
                var actionsHtml = '';

                if (statusClass === 'available') {
                    actionsHtml = '<div class="reward-actions">' +
                        '<button class="pv-btn pv-btn-danger pv-btn-sm" onclick="deleteReward(\'' + reward.id + '\')"><i class="fas fa-trash"></i> ' + getTranslation('pv_delete') + '</button>' +
                        '</div>';
                } else if (statusClass === 'pending') {
                    actionsHtml = '<div class="reward-actions">' +
                        '<button class="pv-btn pv-btn-success pv-btn-sm" onclick="approveRedeem(\'' + reward.id + '\', ' + (reward.pointsCost || 0) + ')"><i class="fas fa-check"></i> ' + getTranslation('pv_approve') + '</button>' +
                        '<button class="pv-btn pv-btn-danger pv-btn-sm" onclick="rejectRedeem(\'' + reward.id + '\')"><i class="fas fa-times"></i> ' + getTranslation('pv_reject') + '</button>' +
                        '</div>';
                }

                return '<div class="reward-card">' +
                    '<div class="reward-card-header">' +
                    '<span class="reward-name">' + escapeHtml(reward.name) + '</span>' +
                    '<span class="reward-status ' + statusClass + '">' + statusText + '</span>' +
                    '</div>' +
                    '<div class="reward-points">' + (reward.pointsCost || 0) + ' <span>' + getTranslation('pv_points_label') + '</span></div>' +
                    actionsHtml +
                    '</div>';
            }).join('');
        }

        function addReward() {
            var nameInput = document.getElementById('rewardNameInput');
            var pointsInput = document.getElementById('rewardPointsInput');
            var name = nameInput.value.trim();
            var points = parseInt(pointsInput.value);

            if (!name) {
                nameInput.focus();
                return;
            }
            if (!points || points < 1) {
                pointsInput.focus();
                return;
            }

            // Add reward to Firestore subcollection
            db.collection('users').doc(connectedUserId).collection('rewards').add({
                name: name,
                pointsCost: points,
                status: 'available',
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            })
            .then(function() {
                nameInput.value = '';
                pointsInput.value = '';
                document.getElementById('addRewardForm').classList.remove('show');
                showToast(getTranslation('pv_success_reward_added'), 'success');
            })
            .catch(function(err) {
                console.error('Error adding reward:', err);
                showToast(getTranslation('pv_error_network'), 'error');
            });
        }

        // Global functions for onclick handlers
        window.approveRedeem = function(rewardId, pointsCost) {
            // Approve: set status to 'redeemed' and deduct points
            var batch = db.batch();
            var rewardRef = db.collection('users').doc(connectedUserId).collection('rewards').doc(rewardId);
            batch.update(rewardRef, {
                status: 'redeemed',
                redeemedAt: firebase.firestore.FieldValue.serverTimestamp()
            });

            // Deduct points from gamification
            var gamRef = db.collection('users').doc(connectedUserId).collection('gamification').doc('data');
            batch.update(gamRef, {
                points: firebase.firestore.FieldValue.increment(-pointsCost)
            });

            batch.commit()
                .then(function() {
                    showToast(getTranslation('pv_success_approved') + ' (' + getTranslation('pv_success_points_deducted') + ': ' + pointsCost + ')', 'success');
                })
                .catch(function(err) {
                    console.error('Error approving reward:', err);
                    showToast(getTranslation('pv_error_network'), 'error');
                });
        };

        window.rejectRedeem = function(rewardId) {
            db.collection('users').doc(connectedUserId).collection('rewards').doc(rewardId).update({
                status: 'available'
            })
            .then(function() {
                showToast(getTranslation('pv_success_rejected'), 'success');
            })
            .catch(function(err) {
                console.error('Error rejecting reward:', err);
            });
        };

        window.deleteReward = function(rewardId) {
            if (!confirm(currentLang === 'ar' ? 'هل أنت متأكد من حذف هذه المكافأة؟' : 'Are you sure you want to delete this reward?')) return;

            db.collection('users').doc(connectedUserId).collection('rewards').doc(rewardId).delete()
                .then(function() {
                    showToast(currentLang === 'ar' ? 'تم الحذف بنجاح' : 'Deleted successfully', 'success');
                })
                .catch(function(err) {
                    console.error('Error deleting reward:', err);
                });
        };

        // ========================================
        // Auto Refresh
        // ========================================
        function startAutoRefresh(userId) {
            if (refreshTimer) clearInterval(refreshTimer);
            refreshTimer = setInterval(function() {
                loadAllStudentData(userId);
            }, 30000); // Every 30 seconds
        }

        function disconnect() {
            if (rewardsUnsub) { rewardsUnsub(); rewardsUnsub = null; }
            if (refreshTimer) { clearInterval(refreshTimer); refreshTimer = null; }
            connectedUserId = null;

            document.getElementById('parentDashboard').style.display = 'none';
            document.getElementById('codeEntry').style.display = 'block';
            document.getElementById('trackingCodeInput').value = '';
            document.getElementById('trackingCodeInput').focus();
        }

        // ========================================
        // Copy Tracking Code
        // ========================================
        function copyTrackingCode() {
            var code = document.getElementById('trackingCodeText').textContent;
            if (navigator.clipboard) {
                navigator.clipboard.writeText(code).then(function() {
                    showToast(getTranslation('pv_copy_code'), 'success');
                });
            }
        }

        // ========================================
        // Init
        // ========================================
        document.addEventListener('DOMContentLoaded', function() {
            initLang();

            // Connect button
            document.getElementById('connectBtn').addEventListener('click', connectStudent);
            document.getElementById('trackingCodeInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') connectStudent();
            });
            document.getElementById('trackingCodeInput').focus();

            // Rewards
            document.getElementById('toggleAddReward').addEventListener('click', function() {
                document.getElementById('addRewardForm').classList.toggle('show');
            });
            document.getElementById('submitReward').addEventListener('click', addReward);

            // Copy tracking code
            document.getElementById('trackingCode').addEventListener('click', copyTrackingCode);

            // Refresh
            document.getElementById('refreshBtn').addEventListener('click', function() {
                if (connectedUserId) {
                    loadAllStudentData(connectedUserId);
                    showToast(currentLang === 'ar' ? 'تم التحديث' : 'Refreshed', 'success');
                }
            });

            // Disconnect
            document.getElementById('disconnectBtn').addEventListener('click', disconnect);
        });
    })();
    </script>
</body>
</html>
